TRANSFER INTERLIS1;

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!
!! Modele de donnees 2001 de la mensuration officielle "Confederation"
!! (MD.01-MO-CH) decrit en INTERLIS version 1 (SN 612030).
!! 
!! Office federal de topographie (S+T)
!! Direction federale des mensurations cadastrales (D+M)
!! CH-3084 Wabern
!! www.swisstopo.ch/fr/vd et www.interlis.ch
!!
!! Version: 23 française
!! Nom du fichier: dm01avch23f.ili (date: 18 decembre 2001)
!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!


MODEL MD01MOCH23F

  DOMAIN

    CoordP = COORD2    480000.000     70000.000
                       840000.000    300000.000;

    CoordA = COORD3    480000.000     70000.000     -200.000
                       840000.000    300000.000     5000.000;

    Altitude = DIM1    -200.000      5000.000;

    Precision = [0.0 .. 700.0]; !! en cm

    Fiabilite = (
      oui,  !! suffisante
      non); !! insuffisante

    Statut = (
      projete,
      valable);

    StandardQualite = (
      MO93,
      MP74,
      NP,
      autre);

    Rotation = GRADS 0.0 399.9;

    GrandeurEcriture = (
      petite,
      moyenne,
      grande);
 
    StyleEcriture = (
      normal,
      ecarte,
      autre);

    Materiel = (
      borne,
      borne_artificielle,
      cheville,
      tuyau, 
      pieu, 
      croix, 
      non_materialise);



   TOPIC Points_fixesCategorie1 =

    TABLE Mise_a_jourPFP1 =
      Identification: TEXT*12;  !! par ex. numero du dossier technique
      Description: TEXT*30;
      Perimetre: OPTIONAL SURFACE WITH (STRAIGHTS, ARCS) VERTEX CoordP
        WITHOUT OVERLAPS > 0.200;
      Date1: DATE; !! par ex. date de mise en service
      Date2: OPTIONAL DATE;
    IDENT Identification;
    END Mise_a_jourPFP1;

    TABLE PFP1 = !! point de triangulation I-IIIe ordre
      Origine: -> Mise_a_jourPFP1; !! relation 1-mc
      Numero: TEXT*12; !! attribution par le S+T
      Geometrie: CoordP;
      GeomAlt: OPTIONAL Altitude;
      PrecPlan: Precision;
      FiabPlan: Fiabilite;
      PrecAlt: OPTIONAL Precision; !! dependant de GeomAlt
      FiabAlt: OPTIONAL Fiabilite; !! dependant de GeomAlt
      Accessibilite: (
        accessible,
        inaccessible);
    IDENT Numero; Geometrie, GeomAlt;
    END PFP1;

    TABLE PosPFP1 =
      Objet: -> PFP1; !! relation 1-1; inscription de Numero
      Pos: CoordP;
      Ori: OPTIONAL Rotation // indefini = 100.0 //;
      HAli: OPTIONAL HALIGNMENT // indefini = Left //;
      VAli: OPTIONAL VALIGNMENT // indefini = Bottom //;
    NO IDENT
    END PosPFP1;

    TABLE SymbolePFP1 =
      Objet: -> PFP1; !! relation 1-c
      Ori: OPTIONAL Rotation // indefini = 0.0 //;
    NO IDENT
    END SymbolePFP1;

    TABLE Mise_a_jourPFA1 =
      Identification: TEXT*12; !! par ex. numero du dossier technique
      Description: TEXT*30;
      Perimetre: OPTIONAL SURFACE WITH (STRAIGHTS, ARCS) VERTEX CoordP
        WITHOUT OVERLAPS > 0.200;
      Date1: DATE; !! par ex. date de mise en service
      Date2: OPTIONAL DATE;
    IDENT Identification;
    END Mise_a_jourPFA1;

     TABLE PFA1 = !! nivellement federal
      Origine: -> Mise_a_jourPFA1; !! relation 1-mc
      Numero: TEXT*12; !! attribution par le S+T
      Geometrie: CoordP;
      GeomAlt: Altitude;
      PrecPlan: OPTIONAL Precision;
      FiabPlan: OPTIONAL Fiabilite;
      PrecAlt: Precision;
      FiabAlt: Fiabilite;
    IDENT Numero; Geometrie;
    END PFA1;

    TABLE PosPFA1 =
      Objet: -> PFA1; !! relation 1-1; inscription de Numero
      Pos: CoordP;
      Ori: OPTIONAL Rotation // indefini = 100.0 //;
      HAli: OPTIONAL HALIGNMENT // indefini = Left //;
      VAli: OPTIONAL VALIGNMENT // indefini = Bottom //;
    NO IDENT
    END PosPFA1;

  END Points_fixesCategorie1.



   TOPIC Points_fixesCategorie2 =

    TABLE Mise_a_jourPFP2 =
      IdentDN: TEXT*8; !! relation 1-m avec Domaine_numerotation
