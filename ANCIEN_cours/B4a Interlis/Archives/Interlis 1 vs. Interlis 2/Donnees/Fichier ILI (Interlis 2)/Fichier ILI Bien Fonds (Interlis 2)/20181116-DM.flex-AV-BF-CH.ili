INTERLIS 2.3;

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!
!! Datenmodell Flex der Amtlichen Vermessung "Bund" (DM.flex-AV-CH)
!! beschrieben in INTERLIS Version 2.3
!!
!! Bundesamt fuer Landestopographie (swisstopo)
!! Eidg. Vermessungsdirektion (V+D)
!! CH-3084 Wabern
!! www.cadastre.ch und www.interlis.ch
!!
!! Version: 1 deutsch
!! Dateiname: DM.flex-AV-CH.ili
!!
!! Das vorliegende Datenmodell gilt fuer den Bezugsrahmen "Landesvermessung 1903+
!! (LV95)".
!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

TYPE MODEL DM_Flex_AV_CH_Geometrie_V1_0 (de)
  AT "http://www.cadastre.ch/xxx" VERSION "2018-11-16" =
  
  DOMAIN
  
    Hoehe = -200.000 ..   5000.000 [INTERLIS.m];
  
END DM_Flex_AV_CH_Geometrie_V1_0.

TYPE MODEL DM_Flex_AV_CH_Modinfo_V1_0 (de)
  AT "http://www.cadastre.ch/xxx" VERSION "2018-11-16" =
  
  DOMAIN
  
    Status = (
      projektiert,
      gueltig,
      annuliert);
      
    UnterhaltsStrategie = (
      /** z.B. Punkt wird ersetzt bei Zerstoerung
      */
      AktiverErhalt,
      PassiverErhalt);
  
END DM_Flex_AV_CH_Modinfo_V1_0.

TYPE MODEL DM_Flex_AV_CH_Qualitaet_V1_0 (de)
  AT "http://www.cadastre.ch/xxx" VERSION "2018-11-16" =
  IMPORTS Units;
  
  DOMAIN
  
    Genauigkeit = 0.000 .. 7.000 [INTERLIS.m];
	
	Schriftgroesse = (
      durchschnittliche
    );

    Zuverlaessigkeit = (
      ja,  !! genuegend
      nein);  !! ungenuegend

    Qualitaetsstandard = (
      AV93,
      PV74,
      PN,
      PEP, !! Provisorischen Ersatzprodukte
      weitere); !! Keine Objekte in der Kategorie weitere, nur fuer Erweiterungen
      
END DM_Flex_AV_CH_Qualitaet_V1_0.

TYPE MODEL DM_Flex_AV_CH_Grafik_V1_0 (de)
  AT "http://www.cadastre.ch/xxx" VERSION "2018-11-16" =
  IMPORTS Units;
  
  DOMAIN
  
    Rotation = 0.0 .. 399.9 [Units.Gon];
  
END DM_Flex_AV_CH_Grafik_V1_0.


TYPE MODEL DM_Flex_AV_CH_Vermarkung_V1_0 (de)
  AT "http://www.cadastre.ch/xxx" VERSION "2018-11-16" =

  DOMAIN

    Versicherungsart = (
      Stein,
      Kunststoffzeichen,
      Bolzen,
      Rohr,
      Pfahl,
      Kreuz,
      unversichert,
      weitere); !! Keine Objekte in der Kategorie weitere, nur fuer Erweiterungen

END DM_Flex_AV_CH_Vermarkung_V1_0.

MODEL DM_Flex_AV_CH_LS_V1_0 (de)
  AT "http://www.cadastre.ch/xxx" VERSION "2018-11-16" =
  IMPORTS Units;
  IMPORTS GeometryCHLV95_V1;
  IMPORTS DM_Flex_AV_CH_Modinfo_V1_0;
  IMPORTS DM_Flex_AV_CH_Vermarkung_V1_0;
  IMPORTS DM_Flex_AV_CH_Qualitaet_V1_0;
  IMPORTS DM_Flex_AV_CH_Grafik_V1_0;

  TOPIC Liegenschaften =
    BASKET OID AS INTERLIS.UUIDOID;
    OID AS INTERLIS.UUIDOID;

    DOMAIN

      Grundstuecksart = (
        Liegenschaft,
        SelbstRecht (
          Baurecht,
          Quellenrecht,
          Konzessionsrecht,
          weitere), !! Keine Objekte in der Kategorie weitere,
                    !! nur fuer Erweiterungen
        Bergwerk);
  
    CLASS LSNachfuehrung =
      NBIdent: MANDATORY TEXT*12;  !! Beziehung 1-m zu Nummerierungsbereich
      Identifikator: MANDATORY TEXT*12;  !! z.B. Nummer des technischen Dossiers
      Beschreibung: MANDATORY TEXT*30;
      Perimeter:  SURFACE WITH (STRAIGHTS, ARCS) VERTEX GeometryCHLV95_V1.Coord2
        WITHOUT OVERLAPS > 0.050;
      Gueltigkeit: MANDATORY DM_Flex_AV_CH_Modinfo_V1_0.Status;
      GueltigerEintrag: MANDATORY INTERLIS.XMLDateTime; !! Techn. Bearbeitung
      GBEintrag: MANDATORY INTERLIS.XMLDateTime;
    UNIQUE NBIdent, Identifikator;
    END LSNachfuehrung;
	
    CLASS Grundstueck =
      NBIdent: MANDATORY TEXT*12;  !! Beziehung 1-m zu Nummerierungsbereich
      Nummer: MANDATORY TEXT*12;
      !! Elektronisches Grundstueckinformationssystem
      EGRIS_EGRID:  TEXT*14;
      !! abgeleitetes Attribut: muss streitig sein, falls Liegenschaft,
      !! SelbstRecht oder Bergwerk streitig;
      Gueltigkeit: MANDATORY (
        rechtskraeftig,
        streitig);
      !!unvollstaendig, falls z.B. das Grundstueck
      !! teilweise ausserhalb des Perimeters liegt.
      Vollstaendigkeit: MANDATORY (
        Vollstaendig,
        unvollstaendig);
      Art: MANDATORY Grundstuecksart;
      !! GesamteFlaechenmass wird nur benutzt, falls TeilGrundstueke existieren.
      !! Das heisst mehrere Objekte Liegenschaft, SelbstRecht
      !! oder Bergwerk werden zu einem Objekt Grundstueck.
      GesamteFlaechenmass:  1 .. 999999999 [Units.m2];
    END Grundstueck;

    CLASS Liegenschaft =
      !! NummerTeilGrundstueck ist fuer Teil Grundstueck noetig
      NummerTeilGrundstueck:  TEXT*12; 
      Geometrie: MANDATORY SURFACE WITH (STRAIGHTS, ARCS) VERTEX GeometryCHLV95_V1.Coord2
        !! // Geometrie nur LFP1, LFP2, LFP3, Grenzpunkt oder Hoheitsgrenzpunkt //
        WITHOUT OVERLAPS > 0.050;
      Flaechenmass: MANDATORY 1 .. 999999999 [Units.m2];
      Streitig: GeometryCHLV95_V1.MultiLine;
    END Liegenschaft;
	
	CLASS Grenzpunkt =
      Identifikator:  TEXT*12;
      Geometrie: MANDATORY GeometryCHLV95_V1.Coord2;
      LageGen: MANDATORY DM_Flex_AV_CH_Qualitaet_V1_0.Genauigkeit;
      LageZuv: MANDATORY DM_Flex_AV_CH_Qualitaet_V1_0.Zuverlaessigkeit;
      Punktzeichen: MANDATORY DM_Flex_AV_CH_Vermarkung_V1_0.Versicherungsart; 
      ExaktDefiniert: MANDATORY (    !! Toleranzvorschriften gemaess TVAV beachten
        ja,
        nein);
      !! Wenn ein "huebscher" alter Hoheitsgrenzstein heruntergestuft wurde
      !! und lediglich die Funktion eines Grenzpunkts hat (siehe auch 
      !! Erklaerungen Kap. 3.11).
      HoheitsgrenzsteinAlt: MANDATORY (
        ja,
        nein);
      GrenzpunktSymbolOri: DM_Flex_AV_CH_Grafik_V1_0.Rotation; !! // undefiniert = 0.0 //
    END Grenzpunkt;

	CLASS GrundstueckPos =
      Pos : MANDATORY GeometryCHLV95_V1.Coord3;
      Ori : MANDATORY DM_Flex_AV_CH_Grafik_V1_0.Rotation;
      HAli : HALIGNMENT;
      VAli : VALIGNMENT;
      Groesse : DM_Flex_AV_CH_Qualitaet_V1_0.Schriftgroesse;
      Hilfslinie : GeometryCHLV95_V1.Line;
    END GrundstueckPos;
	
    ASSOCIATION Entstehung_Grenzpunkt =
        Entstehung -- {1} LSNachfuehrung;
        Mutierte_Grenzpunkt -- {0..*} Grenzpunkt;
    END Entstehung_Grenzpunkt;

    ASSOCIATION LiegenschaftGrundstueckBez =
        Liegenschaft_von -<#> {1} Grundstueck;
        Liegenschaefte -- {0..*} Liegenschaft;
        MANDATORY CONSTRAINT (Liegenschaft_von->Art == #Liegenschaft);        
    END LiegenschaftGrundstueckBez;
	
	ASSOCIATION Entstehung_Grundstueck =
        Entstehung -- {1} LSNachfuehrung;
        Mutierte_Grundstueck -- {0..*} Grundstueck;
    END Entstehung_Grundstueck;
	
	ASSOCIATION Loeschung_Grundstueck =
        Loeschung -- {0..1} LSNachfuehrung;
        Annulierte_Grundstueck -- {0..*} Grundstueck;
    END Loeschung_Grundstueck;
	
	ASSOCIATION Grundst_GrundstPos =
      GrundstueckPos_Von -<#> {1} Grundstueck;
      GrundstueckPosi -- {1..*} GrundstueckPos;
    END Grundst_GrundstPos;
	
	VIEW Grundstueck_Gueltig
     	PROJECTION OF Grundstueck;
    	WHERE DEFINED(Grundstueck->Entstehung) AND Grundstueck->Entstehung->Gueltigkeit==#gueltig AND (NOT(DEFINED(Grundstueck->Loeschung)) OR Grundstueck->Loeschung->Gueltigkeit<>#gueltig);
    	=
    	ALL OF Grundstueck;
    UNIQUE NBIdent, Nummer;
    END Grundstueck_Gueltig;

  END Liegenschaften;
 
END DM_Flex_AV_CH_LS_V1_0.