INCLUDE [ if {{fmebinary} == {fmebinary} } {               puts {MACRO GeometryExtractor_3_Function @Geometry(TO_ATTRIBUTE_BINARY,"Pos") }           } elseif {{fmebinary} == {fmehex} } {               puts {MACRO GeometryExtractor_3_Function @Geometry(TO_ATTRIBUTE_BINARY_HEX,"Pos") }           } elseif {{fmebinary} == {fmexml} } {               puts {MACRO GeometryExtractor_3_Function @Geometry(TO_ATTRIBUTE,"Pos") }           } elseif {{fmebinary} == {polyline} } {               puts {MACRO GeometryExtractor_3_Function @Geometry(TO_ATTRIBUTE_POLYLINE,"Pos",<Unused>) }           } elseif {{fmebinary} == {wkt} } {               puts {MACRO GeometryExtractor_3_Function @OGCGeometry(to_attribute,fmebinary,"Pos",1.2,SHORT_64) }           } elseif {{fmebinary} == {wkb} ||                     {fmebinary} == {wkbhex} } {               puts {MACRO GeometryExtractor_3_Function @OGCGeometry(to_attribute,fmebinary,"Pos",1.2) }           } elseif {{fmebinary} == {GEOJSON} ||                     {fmebinary} == {ESRIJSON} } {               puts {MACRO GeometryExtractor_3_Function @JSONGeometry(TO_ATTRIBUTE,fmebinary,"Pos") }           } elseif {{fmebinary} == {KML} } {               puts {MACRO GeometryExtractor_3_Function @KMLGeometry(TO_ATTRIBUTE,"Pos",<Unused>) }           } elseif {{fmebinary} == {GEORSS_SIMPLE} } {               puts {MACRO GeometryExtractor_3_Function @GeoRSSGeometry(TO_ATTRIBUTE,fmebinary,"Pos",<Unused>) }           } elseif {{fmebinary} == {GML_2.1.2} ||                     {fmebinary} == {GML_3.1.1} ||                     {fmebinary} == {GML_3.2.1} } {               puts {MACRO GeometryExtractor_3_Function @GMLGeometry(TO_ATTRIBUTE,fmebinary,"Pos",<Unused>,NO) }           } elseif {{fmebinary} == {geohash} } {               puts {MACRO GeometryExtractor_3_Function @GeoHash(TO_ATTRIBUTE,"Pos",<Unused>) }           } elseif {{fmebinary} == {ogeosms} } {               puts {MACRO GeometryExtractor_3_Function @OGCGeometry(to_attribute,fmebinary,"Pos",http://maps.google.com/?q=) }           } elseif {{fmebinary} == {geosms} ||                     {fmebinary} == {geo}    } {               puts {MACRO GeometryExtractor_3_Function @OGCGeometry(to_attribute,fmebinary,"Pos") }           } elseif {{fmebinary} == {mgrs} } {               puts {MACRO GeometryExtractor_3_Function @SupplyAttributes(Pos, @MGRS(TO_MGRS, <Unused>, <Unused>, "<Unused>")) }           } elseif {{fmebinary} == {mssql} } {               puts {MACRO GeometryExtractor_3_Function @SerializeGeometry(to_attribute,fmebinary,"Pos","<Unused>")}           } elseif {{fmebinary} == {iso6709} } {               puts {MACRO GeometryExtractor_3_Function @GeographicPoint(TO_ATTRIBUTE,"Pos","<Unused>","<Unused>")}           } elseif {{fmebinary} == {qlikmaps} } {               puts {MACRO GeometryExtractor_3_Function @Geometry(TO_ATTRIBUTE_QLIKMAPS_POLYLINE,"Pos",<Unused>) }           }         ]
# Next determine if we should remove the geometry and also do this once at parse time
# By default, the macro has nothing, meaning we do not remove. If we want to remove, then we'll set the macro to do so

MACRO GeometryExtractor_3_GeometryRemoveFunction
INCLUDE [ if {{No} == {Yes} } {               puts {MACRO GeometryExtractor_3_GeometryRemoveFunction @RemoveGeometry() }           }         ]
