# this statically at parse time for efficiency sake

MACRO GeometryExtractor_2_Function
INCLUDE [ if {{fmebinary} == {fmebinary} } {               puts {MACRO GeometryExtractor_2_Function @Geometry(TO_ATTRIBUTE_BINARY,"Perimeter") }           } elseif {{fmebinary} == {fmehex} } {               puts {MACRO GeometryExtractor_2_Function @Geometry(TO_ATTRIBUTE_BINARY_HEX,"Perimeter") }           } elseif {{fmebinary} == {fmexml} } {               puts {MACRO GeometryExtractor_2_Function @Geometry(TO_ATTRIBUTE,"Perimeter") }           } elseif {{fmebinary} == {polyline} } {               puts {MACRO GeometryExtractor_2_Function @Geometry(TO_ATTRIBUTE_POLYLINE,"Perimeter",<Unused>) }           } elseif {{fmebinary} == {wkt} } {               puts {MACRO GeometryExtractor_2_Function @OGCGeometry(to_attribute,fmebinary,"Perimeter",1.2,SHORT_64) }           } elseif {{fmebinary} == {wkb} ||                     {fmebinary} == {wkbhex} } {               puts {MACRO GeometryExtractor_2_Function @OGCGeometry(to_attribute,fmebinary,"Perimeter",1.2) }           } elseif {{fmebinary} == {GEOJSON} ||                     {fmebinary} == {ESRIJSON} } {               puts {MACRO GeometryExtractor_2_Function @JSONGeometry(TO_ATTRIBUTE,fmebinary,"Perimeter") }           } elseif {{fmebinary} == {KML} } {               puts {MACRO GeometryExtractor_2_Function @KMLGeometry(TO_ATTRIBUTE,"Perimeter",<Unused>) }           } elseif {{fmebinary} == {GEORSS_SIMPLE} } {               puts {MACRO GeometryExtractor_2_Function @GeoRSSGeometry(TO_ATTRIBUTE,fmebinary,"Perimeter",<Unused>) }           } elseif {{fmebinary} == {GML_2.1.2} ||                     {fmebinary} == {GML_3.1.1} ||                     {fmebinary} == {GML_3.2.1} } {               puts {MACRO GeometryExtractor_2_Function @GMLGeometry(TO_ATTRIBUTE,fmebinary,"Perimeter",<Unused>,NO) }           } elseif {{fmebinary} == {geohash} } {               puts {MACRO GeometryExtractor_2_Function @GeoHash(TO_ATTRIBUTE,"Perimeter",<Unused>) }           } elseif {{fmebinary} == {ogeosms} } {               puts {MACRO GeometryExtractor_2_Function @OGCGeometry(to_attribute,fmebinary,"Perimeter",http://maps.google.com/?q=) }           } elseif {{fmebinary} == {geosms} ||                     {fmebinary} == {geo}    } {               puts {MACRO GeometryExtractor_2_Function @OGCGeometry(to_attribute,fmebinary,"Perimeter") }           } elseif {{fmebinary} == {mgrs} } {               puts {MACRO GeometryExtractor_2_Function @SupplyAttributes(Perimeter, @MGRS(TO_MGRS, <Unused>, <Unused>, "<Unused>")) }           } elseif {{fmebinary} == {mssql} } {               puts {MACRO GeometryExtractor_2_Function @SerializeGeometry(to_attribute,fmebinary,"Perimeter","<Unused>")}           } elseif {{fmebinary} == {iso6709} } {               puts {MACRO GeometryExtractor_2_Function @GeographicPoint(TO_ATTRIBUTE,"Perimeter","<Unused>","<Unused>")}           } elseif {{fmebinary} == {qlikmaps} } {               puts {MACRO GeometryExtractor_2_Function @Geometry(TO_ATTRIBUTE_QLIKMAPS_POLYLINE,"Perimeter",<Unused>) }           }         ]
# Next determine if we should remove the geometry and also do this once at parse time
# By default, the macro has nothing, meaning we do not remove. If we want to remove, then we'll set the macro to do so

MACRO GeometryExtractor_2_GeometryRemoveFunction
INCLUDE [ if {{No} == {Yes} } {               puts {MACRO GeometryExtractor_2_GeometryRemoveFunction @RemoveGeometry() }           }         ]
