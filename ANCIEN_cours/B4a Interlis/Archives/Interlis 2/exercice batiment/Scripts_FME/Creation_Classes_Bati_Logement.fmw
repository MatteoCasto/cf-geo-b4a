Tcl2 proc Counter_7dfc1858_c07f_47e8_b14c_2a5346cb6e9a5_createDomain { in_domainName } {    set domainName $in_domainName;    if { {Global} == {Local} }    {       set xFormName [FME_EncodeText {Counter_}];       set domainName $xFormName$domainName;    };    return $domainName; }

