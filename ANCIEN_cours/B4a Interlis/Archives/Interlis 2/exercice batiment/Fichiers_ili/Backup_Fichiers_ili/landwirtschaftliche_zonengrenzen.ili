  END Gueltigkeitsdauer;

  TOPIC Zonengrenzen =
    OID AS INTERLIS.UUIDOID;
    DEPENDS ON Landwirtschaftliche_Zonengrenzen_Kataloge_V1_2.LZ_Kataloge;

