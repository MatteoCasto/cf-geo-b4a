    STRUCTURE Status_Ref
    EXTENDS CatalogueObjects_V1.Catalogues.CatalogueReference =
      Reference (EXTENDED) : MANDATORY REFERENCE TO (EXTERNAL) ErgebnisseBodenbelastung_Punktdaten_Codelisten_V1.CodelistenProjektstandort.Status;
    END Status_Ref;

    DOMAIN

      Surface = SURFACE WITH (ARCS,STRAIGHTS) VERTEX Coord2;

    STRUCTURE Untersuchungstyp_Ref
    EXTENDS CatalogueObjects_V1.Catalogues.CatalogueReference =
      Reference (EXTENDED) : MANDATORY REFERENCE TO (EXTERNAL) ErgebnisseBodenbelastung_Punktdaten_Codelisten_V1.CodelistenProjektstandort.Untersuchungstyp;
    END Untersuchungstyp_Ref;

    /** Projektdaten
     */
    CLASS Projekt =
      /** Name oder Kuerzel des Projekts
       */
      Name : MANDATORY TEXT*25;
      /** Kurzbeschreibung des Projektes
       */
      Kurzinfo : MANDATORY TEXT*60;
      Status_Projekt : MANDATORY Atteintes_sols_Ext_VD.Atteintes_sols.Status_Ref;
      Untersuchungstyp : BAG {1..*} OF Atteintes_sols_Ext_VD.Atteintes_sols.Untersuchungstyp_Ref;
    END Projekt;

    CLASS SolUniteCartographieVD =
      TypeSol : MANDATORY LV_TypeSol;
      MatiereOrganique : MANDATORY LV_MatiereOrganique;
      DegresAcidite : MANDATORY LV_Acidite;
      ProfDecarbonatation : MANDATORY 0 .. 1000;
      RocheMereSup : MANDATORY LV_RocheMere;
      RegimeHydrique : MANDATORY LV_RegimeHydrique;
      ProfPhysiologique : MANDATORY LV_Prof;
      Texture : MANDATORY LV_Texture;
      Pierrosite : MANDATORY LV_Pierrosite;
      Geometrie : MANDATORY Surface;
    END SolUniteCartographieVD;

    CLASS SolUniteViticoleVD =
      CodeCarto : MANDATORY 1 .. 100;
      RocheMere : MANDATORY LVT_RocheMere;
      TypeSol : MANDATORY LVT_TypeSol;
      ProfEnracinement : MANDATORY LVT_ProfEnracinement;
      FicheUnite : TEXT*20;
      Hydromorphie : MANDATORY LVT_Hydromorphie;
      VariantesLocales : LVT_Variantes;
      Geometrie : MANDATORY Surface;
    END SolUniteViticoleVD;

    /** Enthaelt die Standortdaten der Beobachtungsflaeche oder des untersuchten Standortes.
     */
    CLASS Standort =
      /** Standortkuerzel oder Standortnummer
       */
      StandortID : MANDATORY TEXT*60;
      /** Profilblatt FAL, Feld 9
       */
      Kanton : MANDATORY CHCantonCode;
      /** Profilblatt FAL, Feld 8
       */
      Gemeinde : MANDATORY TEXT*100;
      /** Generell:
       * - Punktbeprobung: Standortkoordinaten (bei Profilaufnahme: Profilblatt FAL, Feld 13/14)
       * - Mischprobe Flaeche, Linie: Zentrumskoordinate (wenn nicht anders dokumentiert)
       * 
       * Sonderfall DBF:
       * - Flaechenmischprobe: Zentrumskoordinate der Flaeche (wenn nicht anders dokumentiert)
       * - Profilkoordinaten der DBF sind in Klasse Profil abzulegen
       */
      Koordinaten : MANDATORY Coord2;
    END Standort;

    CLASS Sol
    EXTENDS Standort =
      ID : MANDATORY TEXT*20;
      Type : MANDATORY LV_Type;
      Date : FORMAT INTERLIS.XMLDate "1900-1-1" .. "2999-12-31";
      Commune : TEXT*20;
      LieuDit : TEXT*20;
      CoordX : MANDATORY 2490000 .. 2590000;
      CoordY : MANDATORY 1110000 .. 1210000 CIRCULAR;
      Observateur : TEXT*20;
      Provenance : TEXT*20;
      Commentaires : TEXT*254;
      ProfNappe : 0 .. 1000;
      Pente : LV_Pente;
      Geometrie : MANDATORY Coord2;
    END Sol;

    ASSOCIATION ProjektStandort =
      Projekt -- {1..*} Projekt;
      Standort -- {0..*} Standort;
      DatumVon : FORMAT INTERLIS.XMLDate "1900-1-1" .. "2050-1-1";
      DatumBis : FORMAT INTERLIS.XMLDate "1900-1-1" .. "2050-1-1";
      Bemerkung : MTEXT*500;
      interneBezeichnung : MTEXT*60;
      Status_ProjektStandort : MANDATORY Atteintes_sols_Ext_VD.Atteintes_sols.Status_Ref;
    END ProjektStandort;

    CLASS PointCartographieVD
    EXTENDS Sol =
      TypeSolS : LV_TypeSolSondage;
      TypeSolP : LV_TypeSol;
      RocheMere : MANDATORY LV_LithoSondage;
      TypeHumus : LV_Humus;
      ExcesEau : LV_ExcesEau;
      RegimeHydrique : LV_RegimeHydrique;
      Photo : TEXT*20;
      Utilisation : LV_Utilisation;
      NumCarte : TEXT*20;
    END PointCartographieVD;

    CLASS PointViticoleVD
    EXTENDS Sol =
      TypeRocheP : LVT_LithoP;
      ExcesEauP : LVT_ExcesEau;
      RegimeHydriqueP : LVT_RegimeHydrique;
      TypeRocheS : TEXT*20;
    END PointViticoleVD;

    ASSOCIATION StandortSol =
      Sol -- {0..*} Sol;
      Standort -<#> {1} Standort;
    END StandortSol;

  END Atteintes_sols;

END Atteintes_sols_Ext_VD.
